# Option B: Backend (Vercel + Supabase). Set VITE_API_URL to your Vercel app URL (e.g. https://your-app.vercel.app).
# Then in Vercel env set: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, DATA_SECRET (PIN for /data).
# VITE_API_URL=https://your-app.vercel.app

# Platform spine (Phase 1): Supabase Auth + schemas
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Base path. Default is / (local + Vercel). For GitHub Pages:
# VITE_BASE_PATH=/Tic-Tac-Toe-Memory-Test/
# VITE_BASE_PATH=/

# Google Sheets: send results directly to a sheet (no form). Used only if VITE_API_URL is not set.
# VITE_GOOGLE_SHEETS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Google Form pre-fill (optional – app has defaults; used only if VITE_GOOGLE_SHEETS_SCRIPT_URL is not set)
# VITE_GOOGLE_FORM_BASE=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform
# VITE_ENTRY_NAME=789348548
# VITE_ENTRY_AGE=1922394649
# VITE_ENTRY_GENDER=1816413769
# VITE_ENTRY_DATE=447483951
# VITE_ENTRY_HIGHEST_LEVEL=1329618290
# VITE_ENTRY_ACCURACY=1015731778
# VITE_ENTRY_MEAN_RT=598043661
# VITE_ENTRY_LEVEL_PASSED_COUNT=1944454944
# VITE_ENTRY_TOTAL_CORRECT=351321749
# VITE_ENTRY_TOTAL_TARGETS=298165890
